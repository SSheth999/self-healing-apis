# Copy this file to .env and fill in real values. Never commit .env.
# See AGENTS.md Section 6.5 - secrets via environment variables only.

# Anthropic API key, used by Planner, Coder, and Critic (llm/client.py).
ANTHROPIC_API_KEY=

# GitHub personal access token with repo scope (PR Node, Escalation Node).
# Not needed when running with --dry-run.
GITHUB_TOKEN=

# owner/repo of the target repo the PR Node / Escalation Node act against.
# For local development this can point at a fork of this repo's demo_repo/.
GITHUB_TARGET_REPO=
